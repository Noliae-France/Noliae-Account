fn vue_account(titre: Text, connecte: Bool) -> Text {
    var _o = ""
    _o += "<!doctype html>\n<html lang=\"fr\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"robots\" content=\"noindex,nofollow\"><meta name=\"theme-color\" content=\"#fafaf7\"><title>"
    _o += html_escape(titre)
    _o += "</title><link href=\"https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=JetBrains+Mono:wght@400;500;700&display=swap\" rel=\"stylesheet\"><link rel=\"stylesheet\" href=\"/static/bulma.min.css\"><link rel=\"stylesheet\" href=\"/static/noliae.css\"></head>\n<body><header class=\"topbar\"><a class=\"brand\" data-app=\"search\" href=\"/\" aria-label=\"Noliae\"><svg viewBox=\"0 0 140 100\" aria-hidden=\"true\"><rect x=\"12\" y=\"35\" width=\"10\" height=\"30\" rx=\"5\"/><rect x=\"30\" y=\"25\" width=\"10\" height=\"50\" rx=\"5\"/><rect x=\"48\" y=\"15\" width=\"10\" height=\"70\" rx=\"5\"/><rect class=\"pulse\" x=\"66\" y=\"22\" width=\"10\" height=\"56\" rx=\"5\"/><rect x=\"84\" y=\"20\" width=\"10\" height=\"60\" rx=\"5\"/><rect x=\"102\" y=\"30\" width=\"10\" height=\"40\" rx=\"5\"/><rect x=\"120\" y=\"35\" width=\"10\" height=\"30\" rx=\"5\"/></svg><span data-brand>noliae</span><b>Compte</b></a><nav><a data-app=\"search\" href=\"/\">Search</a><a data-app=\"ia\" href=\"/\">IA</a><a data-app=\"login\" href=\"/\">Connexion</a></nav></header>\n<div class=\"shell\"><aside class=\"sidebar\"><div class=\"identity\"><span class=\"avatar\" id=\"avatar\">NL</span><b id=\"side-name\">Mon compte</b><small id=\"side-email\">Connexion requise</small></div><nav class=\"side-nav\"><p>Compte</p><a class=\"active\" href=\"#profil\">Informations personnelles <span>→</span></a><a href=\"#securite\">Sécurité <span>→</span></a><p>Services &amp; accès</p><a data-app=\"search\" href=\"/\">Noliae Search <span>→</span></a><a data-app=\"ia\" href=\"/\">Noliae IA <span>→</span></a><p>Confidentialité</p><a href=\"#donnees\">Données et confidentialité <span>→</span></a></nav><footer id=\"session-state\">Session contrôlée côté serveur</footer></aside>\n<main class=\"content\"><section class=\"page-head\"><p class=\"cap\">Compte <b>· Accès sécurisé</b></p><h1 id=\"heading\">Votre espace,<br><em>bien protégé.</em></h1><p id=\"subtitle\">Connectez-vous pour accéder à vos informations, préférences et sessions Noliae.</p></section><section class=\"access-card\" id=\"login-card\"><span class=\"lock\">⌁</span><div><h2>Connectez-vous pour continuer</h2><p>Votre session sécurisée vous donne accès à vos paramètres et services.</p></div><a data-app=\"login\" href=\"/\">Se connecter <span>→</span></a><small><i></i> Authentification vérifiée côté serveur</small></section><section class=\"dashboard\" id=\"profile\" hidden><article class=\"card\" id=\"profil\"><header><h2>Profil</h2><span>Synchronisé</span></header><form id=\"name-form\"><label>Nom affiché<input id=\"name\" name=\"name\" autocomplete=\"name\"></label><button type=\"submit\">Enregistrer <span>→</span></button></form></article><article class=\"card\" id=\"securite\"><header><h2>Sécurité</h2><span class=\"safe\"><i></i> <span id=\"mfa-label\">Mot de passe</span></span></header><div class=\"row\"><span>Double authentification (TOTP)</span><b><button type=\"button\" id=\"mfa-enable\">Activer</button><button type=\"button\" id=\"mfa-disable\" hidden>Désactiver</button></b></div><div class=\"row\"><span>Passkey (Touch ID, Face ID, clé de sécurité)</span><b><button type=\"button\" id=\"pk-add\">Ajouter</button></b></div><a class=\"row\" data-app=\"login\" href=\"/reset\">Changer mon mot de passe <b>→</b></a><p id=\"sec-notice\" style=\"padding:0 21px 18px;color:#777771;font-size:12px\"></p></article><article class=\"card\" id=\"sessions\"><header><h2>Sessions actives</h2><span id=\"sess-count\"></span></header><div id=\"sess-list\"></div><div class=\"row\"><span>Se déconnecter de tous les appareils</span><b><button type=\"button\" id=\"sess-revoke-all\">Tout révoquer</button></b></div></article><article class=\"card\" id=\"donnees\"><header><h2>Données et confidentialité</h2><span>RGPD</span></header><div class=\"row\"><span>Exporter mes données (JSON)</span><b><button type=\"button\" id=\"data-export\">Télécharger</button></b></div><div class=\"row\"><span>Supprimer définitivement mon compte</span><b><button type=\"button\" id=\"data-delete\">Supprimer</button></b></div></article></section><p id=\"notice\" aria-live=\"polite\" style=\"margin-top:16px;color:#777771;font-size:13px\"></p></main></div>\n<script src=\"/static/links.js\"></script><script>(()=>{const p=location.hostname.split('.'),api=p.length<3?location.origin:location.protocol+'//api.'+p.slice(1).join('.'),login=p.length<3?'/':location.protocol+'//login.'+p.slice(1).join('.'),goLogin=()=>location.replace(login+'/?return_to='+encodeURIComponent(location.href));fetch(api+'/v1/user/me',{credentials:'include'}).then(async r=>{if(!r.ok)throw new Error('unauthenticated');const user=await r.json();if(!user||!user.id||!user.email)throw new Error('invalid user');return user}).then(user=>{document.getElementById('login-card').hidden=true;const profile=document.getElementById('profile');profile.hidden=false;document.getElementById('heading').textContent='Bonjour, '+user.name;document.getElementById('subtitle').textContent='Gérez vos informations personnelles et vos services Noliae.';document.getElementById('side-name').textContent=user.name;document.getElementById('side-email').textContent=user.email;document.getElementById('name').value=user.name;document.getElementById('avatar').textContent=user.name.slice(0,2).toUpperCase();document.getElementById('session-state').textContent='Session vérifiée côté serveur';document.getElementById('name-form').onsubmit=async e=>{e.preventDefault();const name=document.getElementById('name').value.trim();if(!name)return;const r=await fetch(api+'/v1/user/me/changename',{method:'POST',credentials:'include',headers:{'content-type':'application/json'},body:JSON.stringify({name})});if(!r.ok){document.getElementById('notice').textContent='Impossible d’enregistrer le nom.';return}document.getElementById('notice').textContent='Nom enregistré.';document.getElementById('side-name').textContent=name};const b2b=s=>{s=s.replace(/-/g,'+').replace(/_/g,'/');while(s.length%4)s+='=';const bin=atob(s),u=new Uint8Array(bin.length);for(let i=0;i<bin.length;i++)u[i]=bin.charCodeAt(i);return u.buffer};const b64=b=>{const u=new Uint8Array(b);let s='';for(const x of u)s+=String.fromCharCode(x);return btoa(s).replace(/\\+/g,'-').replace(/\\//g,'_').replace(/=+$/,'')};const secNotice=document.getElementById('sec-notice');const say=(t,ok)=>{secNotice.textContent=t;secNotice.style.color=ok?'#1f9d55':'#c0392b'};const post=(path,body)=>fetch(api+path,{method:'POST',credentials:'include',headers:{'content-type':'application/json'},body:JSON.stringify(body||{})});document.getElementById('mfa-enable').onclick=async()=>{const r=await post('/v1/auth/totp/setup');const o=await r.json().catch(()=>({}));if(!r.ok){say(o.detail||'Impossible de générer la double authentification.');return}const code=prompt('Scannez ce code dans votre application d’authentification, ou saisissez la clé :\\n\\n'+o.otpauth+'\\n\\nClé : '+o.secret+'\\n\\nEntrez le code affiché pour confirmer :');if(!code)return;const r2=await post('/v1/auth/totp/enable',{otp:code});const o2=await r2.json().catch(()=>({}));if(!r2.ok){say(o2.detail||'Code invalide.');return}document.getElementById('mfa-label').textContent='2FA activée';document.getElementById('mfa-enable').hidden=true;document.getElementById('mfa-disable').hidden=false;say('Double authentification activée.',true)};document.getElementById('mfa-disable').onclick=async()=>{const code=prompt('Entrez votre code 2FA actuel pour désactiver la double authentification :');if(!code)return;const r=await post('/v1/auth/totp/disable',{otp:code});const o=await r.json().catch(()=>({}));if(!r.ok){say(o.detail||'Code invalide.');return}document.getElementById('mfa-label').textContent='Mot de passe';document.getElementById('mfa-enable').hidden=false;document.getElementById('mfa-disable').hidden=true;say('Double authentification désactivée.',true)};document.getElementById('pk-add').onclick=async()=>{if(!window.PublicKeyCredential){say('Les passkeys ne sont pas prises en charge par ce navigateur.');return}const r=await post('/v1/auth/passkey/register/begin');const o=await r.json().catch(()=>({}));if(!r.ok){say(o.detail||'Impossible de démarrer l’enregistrement de la passkey.');return}let cred;try{cred=await navigator.credentials.create({publicKey:{challenge:b2b(o.challenge),rp:o.rp,user:{id:b2b(o.user.id),name:o.user.name,displayName:o.user.displayName},pubKeyCredParams:o.pubKeyCredParams,timeout:o.timeout,attestation:o.attestation,authenticatorSelection:o.authenticatorSelection}})}catch(_){say('Enregistrement de la passkey annulé.');return}const r2=await post('/v1/auth/passkey/register/finish',{id:cred.id,rawId:b64(cred.rawId),type:cred.type,response:{clientDataJSON:b64(cred.response.clientDataJSON),attestationObject:b64(cred.response.attestationObject)}});const o2=await r2.json().catch(()=>({}));say(r2.ok?'Passkey ajoutée.':(o2.detail||'Échec de l’enregistrement de la passkey.'),r2.ok)};const sessList=document.getElementById('sess-list'),sessCount=document.getElementById('sess-count');const loadSessions=async()=>{const r=await fetch(api+'/v1/user/me/sessions',{credentials:'include'});const rows=await r.json().catch(()=>[]);if(!r.ok||!Array.isArray(rows)){sessList.innerHTML='';sessCount.textContent='';return}sessCount.textContent=rows.length+' active'+(rows.length>1?'s':'');sessList.innerHTML=rows.map(s=>'<div class=\"row\"><span>'+(s.ip||'IP inconnue')+' · '+(s.user_agent||'appareil inconnu').slice(0,48)+'</span><b><button type=\"button\" data-revoke=\"'+s.id+'\">Révoquer</button></b></div>').join('')||'<div class=\"row\"><span>Aucune session active.</span></div>';sessList.querySelectorAll('[data-revoke]').forEach(btn=>btn.onclick=async()=>{await fetch(api+'/v1/user/me/sessions/'+encodeURIComponent(btn.getAttribute('data-revoke')),{method:'DELETE',credentials:'include'});loadSessions()})};loadSessions();document.getElementById('sess-revoke-all').onclick=async()=>{if(!confirm('Se déconnecter de tous les appareils, y compris celui-ci ?'))return;await post('/v1/user/me/sessions/revoke-all');goLogin()};document.getElementById('data-export').onclick=()=>{window.open(api+'/v1/account/export','_blank')};document.getElementById('data-delete').onclick=async()=>{const pw=prompt('Cette action est définitive. Entrez votre mot de passe pour confirmer la suppression de votre compte :');if(!pw)return;const r=await post('/v1/account/delete',{password:pw});const o=await r.json().catch(()=>({}));if(!r.ok){say(o.detail||'Mot de passe invalide.');return}location.href=login}}).catch(goLogin)})();</script></body></html>\n"
    return _o
}
