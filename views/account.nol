fn vue_account(titre: Text, connecte: Bool) -> Text {
    var _o = ""
    _o += "<!doctype html>\n<html lang=\"fr\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"theme-color\" content=\"#111111\"><title>"
    _o += html_escape(titre)
    _o += "</title><meta name=\"robots\" content=\"noindex,nofollow\"><link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin><link href=\"https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=JetBrains+Mono:wght@400;500;700&display=swap\" rel=\"stylesheet\"><link rel=\"stylesheet\" href=\"/static/noliae.css\"></head>\n<body>\n<header class=\"topbar\"><a class=\"brand\" href=\"/\" aria-label=\"Noliae\"><svg viewBox=\"0 0 140 100\" aria-hidden=\"true\"><rect x=\"12\" y=\"35\" width=\"10\" height=\"30\" rx=\"5\"/><rect x=\"30\" y=\"25\" width=\"10\" height=\"50\" rx=\"5\"/><rect x=\"48\" y=\"15\" width=\"10\" height=\"70\" rx=\"5\"/><rect class=\"pulse\" x=\"66\" y=\"22\" width=\"10\" height=\"56\" rx=\"5\"/><rect x=\"84\" y=\"20\" width=\"10\" height=\"60\" rx=\"5\"/><rect x=\"102\" y=\"30\" width=\"10\" height=\"40\" rx=\"5\"/><rect x=\"120\" y=\"35\" width=\"10\" height=\"30\" rx=\"5\"/></svg><span>noliae</span><b>Compte</b></a><nav><a href=\"/\">Search</a><a href=\"/\">IA</a><a href=\"/\">Connexion</a></nav></header>\n<div class=\"shell\">\n<aside class=\"sidebar\"><div class=\"identity\"><span class=\"avatar\">NL</span><b>Mon compte</b><small>Géré par NolCore</small></div><nav class=\"side-nav\"><p>Compte</p><a class=\"active\" href=\"#profil\">Informations personnelles <span>→</span></a><a href=\"#securite\">Sécurité <span>→</span></a><p>Services &amp; accès</p><a href=\"/\">Noliae Search <span>→</span></a><a href=\"/\">Noliae IA <span>→</span></a><p>Confidentialité</p><a href=\"#donnees\">Données et confidentialité <span>→</span></a></nav><footer>ID session · vérifié par NolCore</footer></aside>\n<main class=\"content\">\n"
    if connecte {
    _o += "\n<section class=\"page-head\"><p class=\"cap\">Compte <b>· Identité</b></p><h1>Informations personnelles</h1><p>Vos informations et vos préférences sur les services Noliae.</p></section><section class=\"dashboard\"><article class=\"card\"><header><h2>Profil</h2><span>Synchronisé</span></header><form action=\"/v1/user/me/changename\" method=\"post\"><label>Nom affiché<input name=\"name\" placeholder=\"Votre nom\"></label><button>Enregistrer <span>→</span></button></form></article><article class=\"card\" id=\"securite\"><header><h2>Sécurité</h2><span class=\"safe\"><i></i> Protégée</span></header><p>La session est contrôlée côté Core, avec cookie HttpOnly et règles d’accès.</p><a class=\"row\" href=\"/v1/user/me/changepassword\">Changer mon mot de passe <b>→</b></a></article></section>\n"
    } else {
    _o += "\n<section class=\"page-head\"><p class=\"cap\">Compte <b>· Accès sécurisé</b></p><h1>Votre espace,<br><em>bien protégé.</em></h1><p>Noliae ne lit jamais une session dans l’interface. NolCore la valide avant tout accès à vos données.</p></section><section class=\"access-card\"><span class=\"lock\">⌁</span><div><h2>Connectez-vous pour continuer</h2><p>Votre cookie de session sécurisé vous donnera accès à vos paramètres, services et préférences.</p></div><a href=\"/\">Se connecter <span>→</span></a><small><i></i> Session vérifiée côté serveur</small></section>\n"
    }
    _o += "\n</main></div><script>(async()=>{const h=location.hostname;const a=h.startsWith(\"account.\")?location.protocol+\"//api.\"+h.slice(8):location.origin;try{const r=await fetch(a+\"/v1/branding\");if(!r.ok)return;const b=await r.json(),n=b.name||\"NolCore\";document.title=\"Compte — \"+n;document.querySelectorAll(\"a\").forEach(x=>{if(x.href.includes(\"login.\"))x.href=b.login_url||\"/\";else if(x.href.includes(\"ia.\"))x.href=b.ia_url||\"/\";else if(x.href.includes(\"noliae.com\"))x.href=b.search_url||b.website_url||\"/\"});document.querySelectorAll(\".brand span\").forEach(x=>x.textContent=n)}catch(_){}\ntry{const mount=document.querySelector(\"#securite\")||document.querySelector(\"main\");if(mount){const box=document.createElement(\"section\");box.className=\"card\";box.style.marginTop=\"16px\";box.innerHTML=\"<h2>Sécurité avancée</h2><div style='display:flex;flex-wrap:wrap;gap:8px;margin:10px 0'><button id='mfa-on' type='button'>Activer la 2FA (TOTP)</button><button id='mfa-off' type='button'>Désactiver la 2FA</button><button id='pk-add' type='button'>Ajouter une passkey</button><button id='sess' type='button'>Mes sessions</button><button id='exp' type='button'>Exporter mes données</button><button id='del' type='button' style='color:#c0392b'>Supprimer mon compte</button></div><div id='sec-out' style='font-size:13px;white-space:pre-wrap;color:#4A4A4A'></div>\";mount.appendChild(box);const out=box.querySelector(\"#sec-out\"),say=m=>{out.textContent=m||\"\"};const b2b=s=>{s=s.replace(/-/g,'+').replace(/_/g,'/');while(s.length%4)s+='=';const bb=atob(s),u=new Uint8Array(bb.length);for(let i=0;i<bb.length;i++)u[i]=bb.charCodeAt(i);return u.buffer};const b64=bf=>{const u=new Uint8Array(bf);let s='';for(const x of u)s+=String.fromCharCode(x);return btoa(s).replace(/\\+/g,'-').replace(/\\//g,'_').replace(/=+$/,'')};const post=(p,body)=>fetch(a+p,{method:'POST',credentials:'include',headers:{'content-type':'application/json'},body:JSON.stringify(body||{})});box.querySelector('#mfa-on').onclick=async()=>{const r=await post('/v1/auth/totp/setup');const o=await r.json();if(!r.ok){say(o.detail||'Erreur');return}const code=prompt('Ajoute ce compte à ton authenticator :\\n'+o.otpauth+'\\n\\n(secret : '+o.secret+')\\n\\nPuis entre le code affiché :');if(!code)return;const r2=await post('/v1/auth/totp/enable',{otp:code});const o2=await r2.json();say(r2.ok?'2FA activée ✓':(o2.detail||'Code invalide'))};box.querySelector('#mfa-off').onclick=async()=>{const code=prompt('Code 2FA actuel pour confirmer la désactivation :');if(!code)return;const r=await post('/v1/auth/totp/disable',{otp:code});const o=await r.json();say(r.ok?'2FA désactivée':(o.detail||'Erreur'))};box.querySelector('#pk-add').onclick=async()=>{const r=await post('/v1/auth/passkey/register/begin');const o=await r.json();if(!r.ok){say(o.detail||'Erreur');return}const pub={challenge:b2b(o.challenge),rp:o.rp,user:{id:b2b(o.user.id),name:o.user.name,displayName:o.user.displayName},pubKeyCredParams:o.pubKeyCredParams,timeout:o.timeout,attestation:o.attestation,authenticatorSelection:o.authenticatorSelection};let cred;try{cred=await navigator.credentials.create({publicKey:pub})}catch(e){say('Passkey annulée ou non compatible (clé EdDSA requise).');return}const body={id:cred.id,rawId:b64(cred.rawId),type:cred.type,response:{clientDataJSON:b64(cred.response.clientDataJSON),attestationObject:b64(cred.response.attestationObject)}};const r2=await post('/v1/auth/passkey/register/finish',body);const o2=await r2.json();say(r2.ok?'Passkey ajoutée ✓':(o2.detail||'Échec de l enregistrement'))};box.querySelector('#sess').onclick=async()=>{const r=await fetch(a+'/v1/user/me/sessions',{credentials:'include'});const o=await r.json().catch(()=>[]);if(!r.ok){say('Erreur');return}say((o||[]).map(s=>'• '+(s.ip||'?')+' — '+String(s.user_agent||'inconnu').slice(0,60)+' (exp '+String(s.expires_at||'').slice(0,10)+')').join('\\n')||'Aucune session active')};box.querySelector('#exp').onclick=()=>{window.open(a+'/v1/account/export','_blank')};box.querySelector('#del').onclick=async()=>{const pw=prompt('Confirme ton mot de passe pour SUPPRIMER définitivement ton compte :');if(!pw)return;const r=await post('/v1/account/delete',{password:pw});const o=await r.json().catch(()=>({}));if(r.ok){alert('Compte supprimé.');location.href='/'}else say(o.detail||'Erreur')}}}catch(_){}\n})();</script><script src=\"/static/links.js\"></script></body></html>\n"
    return _o
}
