@model(titre: Text, connecte: Bool)
<!doctype html>
<html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#111111"><title>@titre</title><meta name="robots" content="noindex,nofollow"><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@@9..40,400;9..40,500;9..40,600&family=JetBrains+Mono:wght@@400;500;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="/static/noliae.css"></head>
<body>
<header class="topbar"><a class="brand" href="https://noliae.com" aria-label="Noliae"><svg viewBox="0 0 140 100" aria-hidden="true"><rect x="12" y="35" width="10" height="30" rx="5"/><rect x="30" y="25" width="10" height="50" rx="5"/><rect x="48" y="15" width="10" height="70" rx="5"/><rect class="pulse" x="66" y="22" width="10" height="56" rx="5"/><rect x="84" y="20" width="10" height="60" rx="5"/><rect x="102" y="30" width="10" height="40" rx="5"/><rect x="120" y="35" width="10" height="30" rx="5"/></svg><span>noliae</span><b>Compte</b></a><nav><a href="https://noliae.com">Search</a><a href="https://ia.noliae.com">IA</a><a href="https://login.noliae.com">Connexion</a></nav></header>
<div class="shell">
<aside class="sidebar"><div class="identity"><span class="avatar">NL</span><b>Mon compte</b><small>Géré par NolCore</small></div><nav class="side-nav"><p>Compte</p><a class="active" href="#profil">Informations personnelles <span>→</span></a><a href="#securite">Sécurité <span>→</span></a><p>Services &amp; accès</p><a href="https://noliae.com">Noliae Search <span>→</span></a><a href="https://ia.noliae.com">Noliae IA <span>→</span></a><p>Confidentialité</p><a href="#donnees">Données et confidentialité <span>→</span></a></nav><footer>ID session · vérifié par NolCore</footer></aside>
<main class="content">
@if(connecte)
<section class="page-head"><p class="cap">Compte <b>· Identité</b></p><h1>Informations personnelles</h1><p>Vos informations et vos préférences sur les services Noliae.</p></section><section class="dashboard"><article class="card"><header><h2>Profil</h2><span>Synchronisé</span></header><form action="/v1/user/me/changename" method="post"><label>Nom affiché<input name="name" placeholder="Votre nom"></label><button>Enregistrer <span>→</span></button></form></article><article class="card" id="securite"><header><h2>Sécurité</h2><span class="safe"><i></i> Protégée</span></header><p>La session est contrôlée côté Core, avec cookie HttpOnly et règles d’accès.</p><a class="row" href="/v1/user/me/changepassword">Changer mon mot de passe <b>→</b></a></article></section>
@else
<section class="page-head"><p class="cap">Compte <b>· Accès sécurisé</b></p><h1>Votre espace,<br><em>bien protégé.</em></h1><p>Noliae ne lit jamais une session dans l’interface. NolCore la valide avant tout accès à vos données.</p></section><section class="access-card"><span class="lock">⌁</span><div><h2>Connectez-vous pour continuer</h2><p>Votre cookie de session sécurisé vous donnera accès à vos paramètres, services et préférences.</p></div><a href="https://login.noliae.com">Se connecter <span>→</span></a><small><i></i> Session vérifiée côté serveur</small></section>
@endif
</main></div></body></html>
