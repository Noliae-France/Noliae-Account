@model(titre: Text, connecte: Bool)
<!doctype html>
<html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><meta name="theme-color" content="#fafaf7"><title>@titre</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@@9..40,400;9..40,500;9..40,600&family=JetBrains+Mono:wght@@400;500;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="/static/noliae.css"></head>
<body><header class="topbar"><a class="brand" data-app="search" href="/" aria-label="Noliae"><svg viewBox="0 0 140 100" aria-hidden="true"><rect x="12" y="35" width="10" height="30" rx="5"/><rect x="30" y="25" width="10" height="50" rx="5"/><rect x="48" y="15" width="10" height="70" rx="5"/><rect class="pulse" x="66" y="22" width="10" height="56" rx="5"/><rect x="84" y="20" width="10" height="60" rx="5"/><rect x="102" y="30" width="10" height="40" rx="5"/><rect x="120" y="35" width="10" height="30" rx="5"/></svg><span data-brand>noliae</span><b>Compte</b></a><nav><a data-app="search" href="/">Search</a><a data-app="ia" href="/">IA</a><a data-app="login" href="/">Connexion</a></nav></header>
<div class="shell"><aside class="sidebar"><div class="identity"><span class="avatar" id="avatar">NL</span><b id="side-name">Mon compte</b><small id="side-email">Connexion requise</small></div><nav class="side-nav"><p>Compte</p><a class="active" href="#profil">Informations personnelles <span>→</span></a><a href="#securite">Sécurité <span>→</span></a><p>Services &amp; accès</p><a data-app="search" href="/">Noliae Search <span>→</span></a><a data-app="ia" href="/">Noliae IA <span>→</span></a><p>Confidentialité</p><a href="#donnees">Données et confidentialité <span>→</span></a></nav><footer id="session-state">Session contrôlée côté serveur</footer></aside>
<main class="content"><section class="page-head"><p class="cap">Compte <b>· Accès sécurisé</b></p><h1 id="heading">Votre espace,<br><em>bien protégé.</em></h1><p id="subtitle">Connectez-vous pour accéder à vos informations, préférences et sessions Noliae.</p></section><section class="access-card" id="login-card"><span class="lock">⌁</span><div><h2>Connectez-vous pour continuer</h2><p>Votre session sécurisée vous donne accès à vos paramètres et services.</p></div><a data-app="login" href="/">Se connecter <span>→</span></a><small><i></i> Authentification vérifiée côté serveur</small></section><section class="dashboard" id="profile" hidden><article class="card" id="profil"><header><h2>Profil</h2><span>Synchronisé</span></header><form id="name-form"><label>Nom affiché<input id="name" name="name" autocomplete="name"></label><button type="submit">Enregistrer <span>→</span></button></form></article><article class="card" id="securite"><header><h2>Sécurité</h2><span class="safe"><i></i> Protégée</span></header><p>Votre session est validée côté serveur. Les options de sécurité disponibles sont affichées uniquement lorsqu’elles sont actives dans le Core.</p><a class="row" data-app="login" href="/">Changer mon mot de passe <b>→</b></a></article><article class="card" id="donnees"><header><h2>Données et confidentialité</h2><span>Vos choix</span></header><p>Les actions d’export et de suppression ne sont jamais simulées : elles apparaîtront ici une fois les parcours RGPD activés par le Core.</p></article></section><p id="notice" aria-live="polite" style="margin-top:16px;color:#777771;font-size:13px"></p></main></div>
<script src="/static/links.js"></script><script>(()=>{const p=location.hostname.split('.'),api=p.length<3?location.origin:location.protocol+'//api.'+p.slice(1).join('.'),login=p.length<3?'/':location.protocol+'//login.'+p.slice(1).join('.'),goLogin=()=>location.replace(login+'/?return_to='+encodeURIComponent(location.href));fetch(api+'/v1/user/me',{credentials:'include'}).then(async r=>{if(!r.ok)throw new Error('unauthenticated');const user=await r.json();if(!user||!user.id||!user.email)throw new Error('invalid user');return user}).then(user=>{document.getElementById('login-card').hidden=true;const profile=document.getElementById('profile');profile.hidden=false;document.getElementById('heading').textContent='Bonjour, '+user.name;document.getElementById('subtitle').textContent='Gérez vos informations personnelles et vos services Noliae.';document.getElementById('side-name').textContent=user.name;document.getElementById('side-email').textContent=user.email;document.getElementById('name').value=user.name;document.getElementById('avatar').textContent=user.name.slice(0,2).toUpperCase();document.getElementById('session-state').textContent='Session vérifiée côté serveur';document.getElementById('name-form').onsubmit=async e=>{e.preventDefault();const name=document.getElementById('name').value.trim();if(!name)return;const r=await fetch(api+'/v1/user/me/changename',{method:'POST',credentials:'include',headers:{'content-type':'application/json'},body:JSON.stringify({name})});if(!r.ok){document.getElementById('notice').textContent='Impossible d’enregistrer le nom.';return}document.getElementById('notice').textContent='Nom enregistré.';document.getElementById('side-name').textContent=name}}).catch(goLogin)})();</script></body></html>
