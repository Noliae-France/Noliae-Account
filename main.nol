import "vendor/nolc/lib/web.nol"
import "views/account.nol"
// L’UI ne déduit jamais une authentification de la seule présence du cookie.
// L’Ingress transmet les routes /v1/* à NolCore, qui est la seule autorité de validation.
fn home(_req:Requete,_p:Map<Text>)->WebResultat{return WebResultat.WebOk(reponse_html(vue_account("Compte Noliae",false)))}
fn health(_r:Requete,_p:Map<Text>)->WebResultat{return WebResultat.WebOk(reponse_json("{\"status\":\"ok\",\"service\":\"noliae-account\",\"runtime\":\"nolc\"}"))}
fn robots(_r:Requete,_p:Map<Text>)->WebResultat{return WebResultat.WebOk(reponse_avec_entete(reponse_texte("User-agent: *\nDisallow: /\n"),"Content-Type","text/plain"))}
fn app(req:Requete)->WebResultat{var m: List<Text> = [];var p: List<Text> = [];var h: List<Fn(Requete,Map<Text>)->WebResultat> = [];route_type(m,p,h,"GET","/",home);route_type(m,p,h,"GET","/api/health",health);route_type(m,p,h,"GET","/robots.txt",robots);if starts_with(req.chemin,"/static/"){let f=file_read("."+req.chemin);if has(f){return WebResultat.WebOk(reponse_avec_entete(reponse_texte(unwrap_or(f,"")),"Content-Type",type_mime(req.chemin)))}}return routeur_dispatch_type(m,p,h,req)}
fn main(){let l=tcp_listen(unwrap_or(parse_int(unwrap_or(env("NOLIAE_PORT"),"8080")),8080));if not has(l){return};let s=unwrap_or(l,-1);let lim=web_limites_defaut();var post: List<Fn(Requete,Reponse)->Reponse> = [];push(post,middleware_securite);while true{let a=tcp_accept(s);if has(a){let c=unwrap_or(a,-1);let out=web_repondre_resultat(unwrap_or(tcp_read(c),""),lim,app,post);let _w=tcp_write(c,out);tcp_close(c)}}}
